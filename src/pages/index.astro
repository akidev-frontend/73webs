---
import '../css/main.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SectionSeam from '../components/SectionSeam.astro';
import Pain from '../components/Pain.astro';
import Build from '../components/Build.astro';
import Solution from '../components/Solution.astro';
import Features from '../components/Features.astro';
import Objection from '../components/Objection.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';

const title = '73webs — ¿Qué pasa con tu negocio si mañana cierra Instagram?';
const description = 'Para pequeños negocios, comercios y PYMEs. Creamos tu web propia, tu contacto directo por WhatsApp y tu ficha de Google para que nadie pueda apagarte el negocio con un solo clic.';
---

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://73webs.com/">

<meta property="og:type" content="website">
<meta property="og:url" content="https://73webs.com/">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:locale" content="es_ES">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" href="/favicon.ico">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Asap:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css">
</head>
<body>

<Nav />
<Hero />
<SectionSeam />
<Pain />
<Build />
<Solution />
<Features />
<Objection />
<FinalCta />
<Footer />

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/DrawSVGPlugin.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollToPlugin.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.fog.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.umd.js"></script>
<script>
  // bundled by Astro as a deferred module, so it runs after the classic CDN
  // scripts above have defined gsap / VANTA / Lenis / CookieConsent
  import '../js/main.js';
</script>
</body>
</html>
