<div class="section-seam" aria-hidden="true">
  <svg class="seam-line" viewBox="0 0 1200 60" preserveAspectRatio="none">
    <defs>
      <linearGradient id="seamGrad" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0%" stop-color="var(--gold)" stop-opacity="0"/>
        <stop offset="50%" stop-color="var(--gold)" stop-opacity="0.9"/>
        <stop offset="100%" stop-color="var(--gold)" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <line x1="0" y1="30" x2="1200" y2="30" stroke="url(#seamGrad)" stroke-width="1.5" id="seamStroke"/>
  </svg>
</div>
