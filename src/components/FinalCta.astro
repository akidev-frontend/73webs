---
---

<section class="final" id="final">
  <div class="final-waves" id="finalWaves"></div>
  <div class="wrap">
    <h2 class="vp-target">Deja de pagar alquiler en las redes sociales. <em>Compra tu propia casa digital.</em></h2>
    <p class="final-copy">Es más fácil y rápido de lo que crees. Cuéntame a qué se dedica tu negocio y empezamos a diseñar tu libertad online.</p>
    <p class="final-limit">Trabajamos con un número limitado de negocios al mes para que cada web salga perfecta.</p>

    <form class="final-form" id="finalForm" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="fName">Nombre</label>
          <input type="text" id="fName" name="nombre" placeholder="Tu nombre" required>
        </div>
        <div class="form-field">
          <label for="fEmail">Email</label>
          <input type="email" id="fEmail" name="email" placeholder="tu@email.com" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="fPhone">Teléfono</label>
          <input type="tel" id="fPhone" name="telefono" placeholder="600 000 000" required>
        </div>
        <div class="form-field">
          <label for="fBusiness">Tu negocio</label>
          <input type="text" id="fBusiness" name="negocio" placeholder="Nombre del negocio">
        </div>
      </div>
      <div class="hp-field" aria-hidden="true">
        <label for="fWeb">Deja este campo vacío</label>
        <input type="text" id="fWeb" name="empresa_web" tabindex="-1" autocomplete="off">
      </div>
      <button type="submit" class="btn btn-gold final-cta" id="finalCta">Quiero mi web y mi sistema propio</button>
      <p class="form-note" id="formNote" aria-live="polite"></p>
    </form>

    <div class="final-direct">
      <span class="final-direct-label">O si lo prefieres, contacta directo</span>
      <div class="final-direct-links">
        <a class="btn btn-ghost final-direct-btn" href="https://wa.me/34624267058?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20mi%20web" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" width="18" height="18"><path d="M3 21l1.65-4.95A8.5 8.5 0 1 1 8.05 19.5L3 21Z" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 9.5c0 3.5 2.5 6 6 6 .5 0 1-.5 1-1l-.3-1.5-2-1-1 1c-1-.5-2-1.5-2.5-2.5l1-1-1-2L9 7c-.5 0-.5.5-.5 2.5Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          +34 624 267 058
        </a>
        <a class="btn btn-ghost final-direct-btn" href="mailto:contacto@73webs.com">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" width="18" height="18"><path d="M3 6h18v12H3z"/><path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          contacto@73webs.com
        </a>
      </div>
    </div>
  </div>
</section>
