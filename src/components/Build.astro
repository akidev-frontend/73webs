---

<section class="build">
  <div class="build-pin">
    <div class="build-stage">
      <div class="build-blue" id="buildBlue"></div>
      <div class="build-gradient" id="buildGradient"></div>
      <svg class="build-house" viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
        <!-- ground line -->
        <path class="stroke" id="ground" d="M20 300 H380" stroke="var(--muted)" opacity="0.4"/>
        <!-- roof -->
        <path class="stroke" id="roof" d="M60 160 L200 50 L340 160" stroke="var(--cold-bright)"/>
        <!-- walls -->
        <path class="stroke" id="walls" d="M85 160 V290 H315 V160" stroke="var(--cold-bright)"/>
        <!-- door -->
        <path class="stroke" id="door" d="M180 290 V210 H230 V290" stroke="var(--gold-bright)"/>
        <!-- window left -->
        <path class="stroke" id="win1" d="M115 190 H150 V225 H115 Z" stroke="var(--gold-bright)"/>
        <!-- window right -->
        <path class="stroke" id="win2" d="M250 190 H285 V225 H250 Z" stroke="var(--gold-bright)"/>
        <!-- chimney -->
        <path class="stroke" id="chimney" d="M270 100 V70 H300 V125" stroke="var(--gold-bright)"/>
      </svg>
      <p class="build-intro" id="buildIntro">Pero hay una solución.</p>
      <div class="build-caption">
        <p id="buildCap1">La única forma de dormir tranquilo por las noches es tener un <em>terreno propio</em> en internet.</p>
      </div>
    </div>
  </div>
</section>
